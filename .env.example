# Required Discord bot token
DISCORD_TOKEN=replace-me

# Optional Spotify application credentials; set both or neither
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

COMMAND_PREFIX=!
LOG_LEVEL=INFO
QUEUE_LIMIT=200
DEFAULT_VOLUME=50
IDLE_TIMEOUT_SECONDS=300
ALONE_TIMEOUT_SECONDS=60

# Optional: sync slash commands immediately to one development guild
DEVELOPMENT_GUILD_ID=
